# Optional. A 32-byte base64 or 64-character hex key. If unset, Relay creates
# .data/master.key with mode 0600 on first start.
CAPABILITY_MASTER_KEY=

# Localhost is useful for Ollama and the existing Sub2API deployment.
ALLOW_LOCALHOST_CONNECTORS=true

# Enable these only for trusted private-network or HTTP providers.
ALLOW_PRIVATE_CONNECTORS=false
ALLOW_INSECURE_CONNECTORS=false

MAX_UPLOAD_MB=25
MAX_PROVIDER_RESPONSE_MB=50
RUN_WORKER_INTERVAL_MS=700
